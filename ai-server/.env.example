# DerMind AI Server — Ortam Değişkenleri
# Bu dosyayı kopyala: cp .env.example .env

# ── LLM Sağlayıcı ──────────────────────────────
# "ollama"  → ücretsiz, lokal (varsayılan)
# "openai"  → ücretli, bulut
LLM_PROVIDER=ollama

# Ollama ayarları (LLM_PROVIDER=ollama ise geçerli)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI ayarları (LLM_PROVIDER=openai ise geçerli)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Güvenlik ────────────────────────────────────
# Spring Boot ile paylaşılan dahili anahtar (boş bırakılırsa auth devre dışı)
INTERNAL_API_KEY=

# ── CORS ────────────────────────────────────────
# Virgülle ayrılmış izinli origin'ler. Production'da backend URL'ini yaz.
# Development için * uygundur.
ALLOWED_ORIGINS=*
# ALLOWED_ORIGINS=http://localhost:8080,https://dermind.app

# ── Rate Limiting ───────────────────────────────
# slowapi formatı: "10/minute", "100/hour", "1000/day"
SCORE_RATE_LIMIT=60/minute
RECOMMEND_RATE_LIMIT=30/minute
EXPLAIN_RATE_LIMIT=10/minute

# ── SHAP / Açıklama Eşiği ───────────────────────
# Bu eşiğin altındaki etki "önemsiz" sayılır ve response'tan çıkarılır
SHAP_EFFECT_THRESHOLD=0.01

# ── Cache ──────────────────────────────────────
EXPLAIN_CACHE_TTL=3600
EXPLAIN_CACHE_MAX=500

# ── Distributed Tracing (OpenTelemetry) ─────────
# true → OTLP collector'a span gönderilir (Jaeger/Tempo/Honeycomb vb.)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=dermind-ai-server
