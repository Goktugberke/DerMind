# DerMind AI Server — Ortam Degiskenleri
# Kopyala: cp .env.example .env

# LLM Saglayicisi: "ollama" (varsayilan, ucretsiz) veya "openai"
LLM_PROVIDER=ollama

# Ollama ayarlari (LLM_PROVIDER=ollama ise)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI ayarlari (LLM_PROVIDER=openai ise)
OPENAI_API_KEY=sk-...buraya_kendi_key_ini_yaz...
OPENAI_MODEL=gpt-4o-mini
